@page "{id:int}"
@model MovimientoGastos.Pages.Mantenimientos.TiposGasto.DetailsModel
@{
    ViewData["Title"] = "Detalles del Tipo de Gasto";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Detalles del Tipo de Gasto</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-page="/Dashboard/Index">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-page="./Index">Tipos de Gasto</a></li>
        <li class="breadcrumb-item active">Detalles</li>
    </ol>

    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-info-circle me-1"></i>
            Información del Tipo de Gasto
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-2">@Html.DisplayNameFor(model => model.TipoGasto.Codigo)</dt>
                <dd class="col-sm-10">@Html.DisplayFor(model => model.TipoGasto.Codigo)</dd>

                <dt class="col-sm-2">@Html.DisplayNameFor(model => model.TipoGasto.Nombre)</dt>
                <dd class="col-sm-10">@Html.DisplayFor(model => model.TipoGasto.Nombre)</dd>

                <dt class="col-sm-2">@Html.DisplayNameFor(model => model.TipoGasto.Descripcion)</dt>
                <dd class="col-sm-10">@Html.DisplayFor(model => model.TipoGasto.Descripcion)</dd>
            </dl>
        </div>
        <div class="card-footer">
            <div class="d-flex justify-content-between">
                <a asp-page="./Edit" asp-route-id="@Model.TipoGasto.Id" class="btn btn-primary">
                    <i class="fas fa-edit"></i> Editar
                </a>
                <a asp-page="./Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Volver a la Lista
                </a>
            </div>
        </div>
    </div>
</div> 