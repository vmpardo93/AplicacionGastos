@page "{id:int}"
@model MovimientoGastos.Pages.Mantenimientos.TiposGasto.DeleteModel
@{
    ViewData["Title"] = "Eliminar Tipo de Gasto";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Eliminar Tipo de Gasto</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-page="/Dashboard/Index">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-page="./Index">Tipos de Gasto</a></li>
        <li class="breadcrumb-item active">Eliminar</li>
    </ol>

    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-trash me-1"></i>
            Confirmar Eliminación
        </div>
        <div class="card-body">
            <div class="alert alert-danger" role="alert">
                <h4 class="alert-heading">¿Está seguro de que desea eliminar este tipo de gasto?</h4>
                <p>Esta acción no se puede deshacer.</p>
            </div>

            <dl class="row">
                <dt class="col-sm-2">@Html.DisplayNameFor(model => model.TipoGasto.Codigo)</dt>
                <dd class="col-sm-10">@Html.DisplayFor(model => model.TipoGasto.Codigo)</dd>

                <dt class="col-sm-2">@Html.DisplayNameFor(model => model.TipoGasto.Nombre)</dt>
                <dd class="col-sm-10">@Html.DisplayFor(model => model.TipoGasto.Nombre)</dd>

                <dt class="col-sm-2">@Html.DisplayNameFor(model => model.TipoGasto.Descripcion)</dt>
                <dd class="col-sm-10">@Html.DisplayFor(model => model.TipoGasto.Descripcion)</dd>
            </dl>
        </div>
        <div class="card-footer">
            <form method="post">
                <input type="hidden" asp-for="TipoGasto.Id" />
                <div class="d-flex justify-content-between">
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash"></i> Eliminar
                    </button>
                    <a asp-page="./Index" class="btn btn-secondary">
                        <i class="fas fa-times"></i> Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div> 