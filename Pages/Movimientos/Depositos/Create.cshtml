@page
@model MovimientoGastos.Pages.Movimientos.Depositos.CreateModel

@{
    ViewData["Title"] = "Nuevo Depósito";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Nuevo Depósito</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-page="/Index">Inicio</a></li>
        <li class="breadcrumb-item"><a asp-page="./Index">Depósitos</a></li>
        <li class="breadcrumb-item active">Nuevo</li>
    </ol>

    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-plus me-1"></i>
            Crear Depósito
        </div>
        <div class="card-body">
            <form method="post">
                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="DepositoVM.Fecha" class="form-label">Fecha</label>
                    <input asp-for="DepositoVM.Fecha" class="form-control" type="date" />
                    <span asp-validation-for="DepositoVM.Fecha" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="DepositoVM.FondoMonetarioId" class="form-label">Fondo</label>
                    <select asp-for="DepositoVM.FondoMonetarioId" class="form-select" asp-items="@Model.FondosMonetarios">
                        <option value="">Seleccione un fondo</option>
                    </select>
                    <span asp-validation-for="DepositoVM.FondoMonetarioId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="DepositoVM.Monto" class="form-label">Monto</label>
                    <input asp-for="DepositoVM.Monto" class="form-control" type="number" step="0.01" min="0.01" />
                    <span asp-validation-for="DepositoVM.Monto" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i> Guardar
                    </button>
                    <a asp-page="./Index" class="btn btn-secondary">
                        <i class="fas fa-times me-1"></i> Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
} 