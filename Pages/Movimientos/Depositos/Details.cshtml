@page "{id:int}"
@model MovimientoGastos.Pages.Movimientos.Depositos.DetailsModel

@{
    ViewData["Title"] = "Detalles del Depósito";
}

<div class="container-fluid">
    <h1>Detalles del Depósito</h1>

    <div class="card">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Deposito.Fecha)</dt>
                <dd class="col-sm-10">@Html.DisplayFor(model => model.Deposito.Fecha)</dd>

                <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Deposito.FondoMonetario)</dt>
                <dd class="col-sm-10">@Html.DisplayFor(model => model.Deposito.FondoMonetario.Nombre)</dd>

                <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Deposito.Monto)</dt>
                <dd class="col-sm-10">@Html.DisplayFor(model => model.Deposito.Monto)</dd>
            </dl>

            <div class="mt-3">
                <a asp-page="./Edit" asp-route-id="@Model.Deposito.Id" class="btn btn-primary">
                    <i class="fas fa-edit"></i> Editar
                </a>
                <a asp-page="./Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Volver
                </a>
            </div>
        </div>
    </div>
</div> 