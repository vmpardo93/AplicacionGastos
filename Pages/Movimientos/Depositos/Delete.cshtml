@page "{id:int}"
@model MovimientoGastos.Pages.Movimientos.Depositos.DeleteModel

@{
    ViewData["Title"] = "Eliminar Depósito";
}

<div class="container-fluid">
    <h1>Eliminar Depósito</h1>

    <div class="alert alert-danger" role="alert">
        <h4 class="alert-heading">¿Está seguro de que desea eliminar este depósito?</h4>
        <p>Esta acción no se puede deshacer.</p>
    </div>

    <div class="card">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Deposito.Fecha)</dt>
                <dd class="col-sm-10">@Html.DisplayFor(model => model.Deposito.Fecha)</dd>

                <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Deposito.FondoMonetario)</dt>
                <dd class="col-sm-10">@Html.DisplayFor(model => model.Deposito.FondoMonetario.Nombre)</dd>

                <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Deposito.Monto)</dt>
                <dd class="col-sm-10">@Html.DisplayFor(model => model.Deposito.Monto)</dd>
            </dl>

            <form method="post">
                <input type="hidden" asp-for="Deposito.Id" />
                <div class="mt-3">
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash"></i> Eliminar
                    </button>
                    <a asp-page="./Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Volver
                    </a>
                </div>
            </form>
        </div>
    </div>
</div> 