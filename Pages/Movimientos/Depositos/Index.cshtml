@page
@model MovimientoGastos.Pages.Movimientos.Depositos.IndexModel

@{
    ViewData["Title"] = "Depósitos";
}

<div class="container-fluid">
    <h1>Depósitos</h1>

    <p>
        <a asp-page="Create" class="btn btn-primary">
            <i class="fas fa-plus"></i> Crear Nuevo
        </a>
    </p>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.Depositos[0].Fecha)</th>
                            <th>@Html.DisplayNameFor(model => model.Depositos[0].FondoMonetarioNombre)</th>
                            <th>@Html.DisplayNameFor(model => model.Depositos[0].Monto)</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Depositos)
                        {
                            <tr>
                                <td>@Html.DisplayFor(modelItem => item.Fecha)</td>
                                <td>@Html.DisplayFor(modelItem => item.FondoMonetarioNombre)</td>
                                <td>@Html.DisplayFor(modelItem => item.Monto)</td>
                                <td>
                                    <div class="btn-group" role="group">                  
                                        <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">
                                            <i class="fas fa-info-circle"></i> Detalles
                                        </a>
                                        <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">
                                            <i class="fas fa-trash"></i> Eliminar
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div> 