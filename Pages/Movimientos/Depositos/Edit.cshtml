@page "{id:int}"
@model MovimientoGastos.Pages.Movimientos.Depositos.EditModel

@{
    ViewData["Title"] = "Editar Depósito";
}

<div class="container-fluid">
    <h1>Editar Depósito</h1>

    <div class="card">
        <div class="card-body">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Deposito.Id" />

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="Deposito.Fecha" class="control-label"></label>
                            <input asp-for="Deposito.Fecha" class="form-control" type="date" />
                            <span asp-validation-for="Deposito.Fecha" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="Deposito.FondoMonetarioId" class="control-label">Fondo</label>
                            <select asp-for="Deposito.FondoMonetarioId" class="form-select" asp-items="@(new SelectList(Model.FondosMonetarios, "Id", "Nombre"))">
                                <option value="">Seleccione un fondo</option>
                            </select>
                            <span asp-validation-for="Deposito.FondoMonetarioId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="Deposito.Monto" class="control-label"></label>
                            <input asp-for="Deposito.Monto" class="form-control" type="number" step="0.01" />
                            <span asp-validation-for="Deposito.Monto" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="form-group mt-3">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Guardar
                    </button>
                    <a asp-page="./Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Volver
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
} 