@page
@model MovimientoGastos.Pages.Movimientos.Gastos.IndexModel
@{
    ViewData["Title"] = "Registro de Gastos";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Registro de Gastos</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-page="/Dashboard/Index">Dashboard</a></li>
        <li class="breadcrumb-item active">Registro de Gastos</li>
    </ol>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card mb-4">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <i class="fas fa-table me-1"></i>
                    Lista de Gastos
                </div>
                <div>
                    <a asp-page="Create" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Nuevo Gasto
                    </a>
                </div>
            </div>
        </div>
        <div class="card-body">
            <table class="table table-bordered table-striped" id="gastosTable">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Comercio</th>
                        <th>Tipo Doc.</th>
                        <th>Número Doc.</th>
                        <th>Fondo</th>
                        <th>Total</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Gastos)
                    {
                        <tr>
                            <td>@item.Fecha.ToShortDateString()</td>
                            <td>@item.Comercio</td>
                            <td>@item.TipoDoc</td>
                            <td>@item.NumeroDoc</td>
                            <td>@item.FondoMonetario.Nombre</td>
                            <td class="text-end">@item.Total.ToString("C")</td>
                            <td>
                                <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#gastosTable').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json'
                },
                order: [[0, 'desc']] // Ordenar por fecha descendente por defecto
            });
        });
    </script>
} 