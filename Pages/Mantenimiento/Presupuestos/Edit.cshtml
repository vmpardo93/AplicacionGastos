@page
@model MovimientoGastos.Pages.Mantenimiento.Presupuestos.EditModel
@{
    ViewData["Title"] = "Editar Presupuesto";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Editar Presupuesto</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-page="/Index">Inicio</a></li>
        <li class="breadcrumb-item"><a asp-page="./Index">Presupuestos</a></li>
        <li class="breadcrumb-item active">Editar</li>
    </ol>

    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-edit me-1"></i>
            Editar Presupuesto
        </div>
        <div class="card-body">
            <form method="post">
                <div asp-validation-summary="All" class="text-danger"></div>
                <input type="hidden" asp-for="PresupuestoVM.Id" />

                <div class="mb-3">
                    <label asp-for="PresupuestoVM.TipoGastoId" class="form-label">Tipo de Gasto</label>
                    <select asp-for="PresupuestoVM.TipoGastoId" class="form-select" asp-items="@(new SelectList(Model.TiposGasto, "Value", "Text"))">
                        <option value="">Seleccione un tipo de gasto</option>
                    </select>
                    <span asp-validation-for="PresupuestoVM.TipoGastoId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PresupuestoVM.Mes" class="form-label">Mes</label>
                    <select asp-for="PresupuestoVM.Mes" class="form-select" asp-items="@(new SelectList(Model.Meses, "Value", "Text"))">
                        <option value="">Seleccione un mes</option>
                    </select>
                    <span asp-validation-for="PresupuestoVM.Mes" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PresupuestoVM.Monto" class="form-label">Monto</label>
                    <input asp-for="PresupuestoVM.Monto" class="form-control" type="number" step="0.01" min="0.01" />
                    <span asp-validation-for="PresupuestoVM.Monto" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i> Guardar
                    </button>
                    <a asp-page="./Index" class="btn btn-secondary">
                        <i class="fas fa-times me-1"></i> Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
} 