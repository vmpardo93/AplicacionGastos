@page
@model MovimientoGastos.Pages.Mantenimiento.Presupuestos.IndexModel
@{
    ViewData["Title"] = "Presupuestos";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Presupuestos</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-page="/Index">Inicio</a></li>
        <li class="breadcrumb-item active">Presupuestos</li>
    </ol>

    <div class="card mb-4">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <i class="fas fa-table me-1"></i>
                    Lista de Presupuestos
                </div>
                <div>
                    <a asp-page="Create" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Nuevo Presupuesto
                    </a>
                </div>
            </div>
        </div>
        <div class="card-body">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Tipo de Gasto</th>
                        <th>Mes</th>
                        <th>Monto</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Presupuestos)
                    {
                        <tr>
                            <td>@item.TipoGastoNombre</td>
                            <td>@item.NombreMes</td>
                            <td>@item.Monto.ToString("C")</td>
                            <td>
                                <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.table').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json'
                }
            });
        });
    </script>
} 