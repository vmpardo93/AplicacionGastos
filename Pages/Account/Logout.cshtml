@page
@model MovimientoGastos.Pages.Account.LogoutModel
@{
    ViewData["Title"] = "Cerrar Sesión";
}

<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-md-6">
            <div class="card shadow-lg">
                <div class="card-header bg-primary text-white text-center">
                    <h3 class="mb-0">Cerrar Sesión</h3>
                </div>
                <div class="card-body text-center">
                    <p>¿Está seguro que desea cerrar sesión?</p>
                    <form class="form-inline" asp-page="/Account/Logout" method="post">
                        <button type="submit" class="btn btn-danger">Sí, cerrar sesión</button>
                        <a href="javascript:history.back()" class="btn btn-secondary ms-2">Cancelar</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div> 